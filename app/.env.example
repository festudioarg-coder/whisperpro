# Pegá UNA de estas keys (la que tengas). Prioridad: Groq > OpenAI > Gemini. Todas vacías = Whisper local (sin corrección inteligente).
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Atajo: win+space = Win+Espacio empieza (soltás las teclas) y Espacio corta. "caps lock+space" = mantener apretado.
DICTADO_HOTKEY=win+space
# Tecla que, junto con Bloq Mayús, abre el historial
DICTADO_HISTORY_KEY=h
# Escribir en el input en vivo mientras hablás (1 = sí, 0 = solo al soltar)
DICTADO_LIVE=1
# Cada cuántos segundos actualiza el texto en vivo
DICTADO_LIVE_INTERVAL=1.5
# Corrección inteligente al soltar ("no, mejor no, borrá eso") (1 = sí, 0 = literal)
DICTADO_SMART=1
# Idioma: vacío = autodetecta (es/en/pt). Poné "es" si querés forzar español.
DICTADO_LANG=
# Modelo local si no hay key: tiny / base / small / medium
DICTADO_LOCAL_MODEL=small
# Dejar el dictado en el portapapeles del sistema al terminar (lo que tenías copiado antes queda en Bloq Mayús + H)
DICTADO_CLIPBOARD=1
# 1 = imprimir diagnóstico de teclas en la consola
DICTADO_DEBUG=0
